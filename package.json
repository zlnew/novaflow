{
  "name": "novaflow",
  "version": "1.0.1",
  "description": "Daemonless, local-first task ledger for coding agents: SQLite-backed workspaces, projects, and tasks with DAG dependencies, leases, handoff context, a CLI, and an MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "novaflow": "./bin/novaflow"
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlnew/novaflow.git"
  },
  "keywords": [
    "novaflow",
    "agentskills",
    "agent-orchestration",
    "orchestration",
    "orchestrator",
    "cli",
    "mcp",
    "sqlite",
    "tasks",
    "task-queue",
    "dag",
    "workflow",
    "fsm",
    "local-first",
    "daemonless"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
