{
  "name": "novaflow",
  "version": "0.3.2",
  "description": "Deterministic orchestration for chains of Pi coding-agent tasks: per-run git worktrees, gates, verification, and a live operator view.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "nova": "./bin/nova"
  },
  "files": [
    "bin/",
    "src/",
    "extensions/",
    "docs/",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlnew/novaflow.git"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "agent-orchestration",
    "orchestration",
    "workflow",
    "fsm",
    "sqlite",
    "cli",
    "mcp",
    "dag",
    "worktree",
    "task-queue"
  ],
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
