#!/usr/bin/env node
/**
 * nova — the NovaFlow CLI launcher shim (srs 4.1.1).
 *
 * Mechanism (documented choice): Node 24's native type stripping cannot
 * run this codebase — the sources use constructor parameter properties
 * (OpError, ProfileValidationError, …), which are NON-ERASABLE syntax
 * (verified on this box: node v24.21.0 refuses to strip them without
 * the --experimental-transform-types flag). The shim therefore drives
 * the already-installed tsx loader (a devDependency — zero new
 * dependencies) through its documented ESM register API and imports
 * the TS entry in-process.
 */
let register;
try {
  ({ register } = await import("tsx/esm/api"));
} catch {
  // tsx is a devDependency — an --omit=dev install hits this path. Exit 2
  // (usage class), never exit 1: a broken install is not an operation
  // failure (srs 4.1.1 exit rows — review round finding).
  process.stderr.write(
    "nova: the tsx loader is not installed in this checkout.\n" +
      "      run: npm install (or npm ci) in the novaflow repo, then retry.\n",
  );
  process.exit(2);
}
const tsx = register({ namespace: "nova-cli" });

const { main } = await tsx.import("../src/cli/main.ts", import.meta.url);
process.exit(await main(process.argv.slice(2)));
